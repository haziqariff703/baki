# Public browser configuration (Supabase anon key is intentionally public and RLS-scoped)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only secrets — configure in Vercel/GitHub, never expose with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Baki <notifications@example.com>

# Optional: set true only while evaluating CSP violations outside Vercel Preview
CSP_REPORT_ONLY=false
